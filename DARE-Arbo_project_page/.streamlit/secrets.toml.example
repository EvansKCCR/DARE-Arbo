# Copy to secrets.toml and supply real values privately.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "REPLACE_WITH_RANDOM_SECRET"
client_id = "GOOGLE_WEB_CLIENT_ID"
client_secret = "GOOGLE_WEB_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[access]
# Only verified Google identities on this list have document access.
full_access_emails = []

[drive]
# OAuth credentials for the folder owner, not a service account.
client_id = "GOOGLE_DESKTOP_CLIENT_ID"
client_secret = "GOOGLE_DESKTOP_CLIENT_SECRET"
refresh_token = "OWNER_REFRESH_TOKEN"
