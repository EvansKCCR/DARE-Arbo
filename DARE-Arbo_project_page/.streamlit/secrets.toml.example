# Reference for NEW setups only. Never replace an existing live Secrets config
# with this file. Merge only the keys you need; preserve all saved credentials.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "REPLACE_WITH_RANDOM_SECRET"
client_id = "GOOGLE_WEB_CLIENT_ID"
client_secret = "GOOGLE_WEB_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[access]
# Only verified Google identities on this list have document access.
full_access_emails = []

[project_management]
admin_emails = ["evansasamoahadu@gmail.com"]
# Task storage uses the existing [drive] connection and linked workbook.

[drive]
# OAuth credentials for the folder owner, not a service account.
client_id = "GOOGLE_DESKTOP_CLIENT_ID"
client_secret = "GOOGLE_DESKTOP_CLIENT_SECRET"
refresh_token = "OWNER_REFRESH_TOKEN"

[email]
host = "smtp.gmail.com"
port = 587
username = "evansasamoahadu@gmail.com"
from_address = "evansasamoahadu@gmail.com"
# Intentionally no password default. Preserve the live email.password value.
# Enter the Gmail app password privately in the existing live [email] section.
app_url = "https://dare-arbo-gxsla2u2vugc8gnsjyessi.streamlit.app/"
