[microsoft]
# Private service connection used only by the app to reach the named-access OneDrive folder.
# Collaborators do not sign in to Microsoft. The refresh token must belong to an account
# with named access to this folder and delegated Files.ReadWrite, User.Read and Mail.Send.
client_id = "YOUR_MICROSOFT_APPLICATION_CLIENT_ID"
client_secret = "YOUR_MICROSOFT_APPLICATION_CLIENT_SECRET"
refresh_token = "OWNER_MICROSOFT_REFRESH_TOKEN"
